        <StreamGeometry x:Key="IconSteering">M12 2a10 10 0 100 20 10 10 0 000-20zm0 2c3.9 0 7.15 2.8 7.86 6.5h-3.92a4 4 0 00-3.94-3.5V4zm-1 0v3a4 4 0 00-3.94 3.5H3.14C3.85 6.8 7.1 4 11 4zm-7.86 8.5h4.08A4 4 0 0011 16v4c-4.42-.5-7.9-4-8.86-7.5zm16.72 0c-.96 3.5-4.44 7-8.86 7.5v-4a4 4 0 003.78-3.5h4.08z</StreamGeometry>
        <StreamGeometry x:Key="IconGamepad">M6 5h12a5 5 0 015 5v5a4 4 0 01-6.8 2.8L13.8 15h-3.6l-2.4 2.8A4 4 0 011 15v-5a5 5 0 015-5zm-1 7H3v2a2 2 0 003.4 1.4L8.2 13H5zm14 0h-3.2l1.8 2.4A2 2 0 0021 14v-2h-2zM7 9v1H6v1h1v1h1v-1h1v-1H8V9H7zm10 0a1 1 0 100 2 1 1 0 000-2zm-2 2a1 1 0 100 2 1 1 0 000-2zm4 0a1 1 0 100 2 1 1 0 000-2zm-2 2a1 1 0 100 2 1 1 0 000-2z</StreamGeometry>
