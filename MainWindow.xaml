                                        <ProgressBar x:Name="ProgLiveSteerLeft" Grid.Row="2" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource BgInput}" Foreground="{StaticResource ChannelSteerLeft}" BorderThickness="0" Margin="0,4,12,4" />
                                        <TextBlock x:Name="TxtLiveSteerLeftVal" Grid.Row="2" Grid.Column="2" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ChannelSteerLeft}" VerticalAlignment="Center" HorizontalAlignment="Right" />

