                    <Border x:Name="ProfileToastBanner" Visibility="Collapsed" Background="#351F2A3D" BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" Padding="12,4" Height="30">
