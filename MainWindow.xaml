                                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    
                                </StackPanel>
                            </Grid>

                            <!-- Card 1: Live Controller Output Telemetry (Flashy LIVE 1000Hz badge removed) -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource AccentPrimary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Controller Telemetry" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Border Background="#3020283A" BorderBrush="#3B4861" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
