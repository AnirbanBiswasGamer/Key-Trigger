                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" CornerRadius="10,0,0,10">
                <Grid Margin="14,14,14,14">
                    <Grid.RowDefinitions>
                        <!-- App Brand / Logo -->
                        <RowDefinition Height="Auto" />
                        <!-- Nav Items -->
                        <RowDefinition Height="*" />
                        <!-- Master Switch & Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Logo & Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,24">
                        <Border Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo_header.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="KEY" FontSize="15" FontWeight="Black" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="TRIGGER" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation Items with Clean Modern Vector Icons -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <!-- Home / Overview -->
                        <Button x:Name="NavBtnHome" Click="NavBtn_Click" Tag="Home" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}" Fill="{StaticResource TextSecondary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Throttle -->
                        <Button x:Name="NavBtnThrottle" Click="NavBtn_Click" Tag="Throttle" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconThrottle}" Fill="{StaticResource ChannelThrottle}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Throttle" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Brake -->
                        <Button x:Name="NavBtnBrake" Click="NavBtn_Click" Tag="Brake" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBrake}" Fill="{StaticResource ChannelBrake}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Brake" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Steering -->
                        <Button x:Name="NavBtnSteering" Click="NavBtn_Click" Tag="Steering" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSteering}" Fill="{StaticResource ChannelSteerLeft}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Steering" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Remap / Buttons -->
                        <Button x:Name="NavBtnRemap" Click="NavBtn_Click" Tag="Remap" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRemap}" Fill="{StaticResource TextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Remap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Games / Auto-Detect -->
                        <Button x:Name="NavBtnGames" Click="NavBtn_Click" Tag="Games" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource AccentPrimary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-Detect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Profiles -->
                        <Button x:Name="NavBtnProfiles" Click="NavBtn_Click" Tag="Profiles" Style="{StaticResource NavBtnStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconProfiles}" Fill="{StaticResource TextSecondary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Profiles" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Master Toggle & Info (Disabled by Default on Startup) -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <!-- Universal Save Button -->
                        <Button x:Name="BtnUniversalSave" Click="BtnUniversalSave_Click" Style="{StaticResource CardActionBtn}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10" Cursor="Hand" ToolTip="Save all settings, curves, key bindings and remaps to active profile">
