<Window x:Class="KeyTrigger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Key Trigger - Xbox 360 Progressive Input Emulator"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="720" Width="990"
        MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 Frosted Glass Monochrome Palette (No Colors, Even Highlights) -->
        <SolidColorBrush x:Key="BgSidebar" Color="#18000000" />
        <SolidColorBrush x:Key="BgCard" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="BgInput" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#15FFFFFF" />

        <!-- Crisp Monochrome (No Colors, Even Highlights) -->
        <SolidColorBrush x:Key="AccentPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentSecondary" Color="#CCCCCC" />
        <SolidColorBrush x:Key="StatusActive" Color="#FFFFFF" />

        <!-- Monochrome Channel Palette -->
        <SolidColorBrush x:Key="ChannelThrottle" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChannelBrake" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChannelSteerLeft" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChannelSteerRight" Color="#FFFFFF" />

        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A5ACB8" />
        <SolidColorBrush x:Key="TextMuted" Color="#717888" />

        <!-- Crisp Vector Geometries (No text emojis) -->
        <StreamGeometry x:Key="IconHome">M3 10.5L12 3l9 7.5V20a1.5 1.5 0 01-1.5 1.5h-4.5a1 1 0 01-1-1v-4a1 1 0 00-1-1h-2a1 1 0 00-1 1v4a1 1 0 01-1 1H4.5A1.5 1.5 0 013 20v-9.5z</StreamGeometry>
        <StreamGeometry x:Key="IconThrottle">M13 2L3 14h7v8l10-12h-7l3-8z</StreamGeometry>
