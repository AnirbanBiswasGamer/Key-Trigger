                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Steer Left (LS ←)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock x:Name="TxtBoundSteerLeftKey" Text="[ A ]" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button x:Name="BtnRebindSteerLeft" Click="BtnBindSteerLeftKey_Click" Grid.Column="1" Content="Rebind" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Steer Right -->
                                        <Border Grid.Column="2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Steer Right (LS →)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock x:Name="TxtBoundSteerRightKey" Text="[ D ]" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button x:Name="BtnRebindSteerRight" Click="BtnBindSteerRightKey_Click" Grid.Column="1" Content="Rebind" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Ramp Timing -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconTimer}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Timings" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    

                                    <!-- Attack Time -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="Turn Rate" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSteerAttackDisplay" Text="0.20 s" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <Button Content="– 0.10s" Style="{StaticResource StepBtnStyle}" Click="StepSteerAttack_Click" Tag="-0.10" ToolTip="Decrease 0.10s" />
                                            <Button Content="– 0.01s" Style="{StaticResource StepBtnStyle}" Click="StepSteerAttack_Click" Tag="-0.01" ToolTip="Decrease 0.01s" Margin="4,0,0,0" />
                                            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Height="32" Width="95" Margin="8,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtSteerAttackInput" Text="0.20" LostFocus="TxtSteerAttackInput_LostFocus" KeyDown="TxtSteerAttackInput_KeyDown" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Grid.Column="1" Text="s" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                </Grid>
                                            </Border>
                                            <Button Content="+ 0.01s" Style="{StaticResource StepBtnStyle}" Click="StepSteerAttack_Click" Tag="0.01" ToolTip="Increase 0.01s" />
                                            <Button Content="+ 0.10s" Style="{StaticResource StepBtnStyle}" Click="StepSteerAttack_Click" Tag="0.10" ToolTip="Increase 0.10s" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Direct (0.01s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerAttack_Click" Tag="0.01" />
                                            <Button Content="Formula 1 (0.08s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerAttack_Click" Tag="0.08" />
                                            <Button Content="Sport (0.20s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerAttack_Click" Tag="0.20" />
                                            <Button Content="Smooth (0.35s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerAttack_Click" Tag="0.35" />
                                            <Button Content="Truck/Heavy (0.70s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerAttack_Click" Tag="0.70" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Release Time -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="Return Rate" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSteerReleaseDisplay" Text="0.09 s" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <Button Content="– 0.10s" Style="{StaticResource StepBtnStyle}" Click="StepSteerRelease_Click" Tag="-0.10" ToolTip="Decrease 0.10s" />
                                            <Button Content="– 0.01s" Style="{StaticResource StepBtnStyle}" Click="StepSteerRelease_Click" Tag="-0.01" ToolTip="Decrease 0.01s" Margin="4,0,0,0" />
                                            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Height="32" Width="95" Margin="8,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtSteerReleaseInput" Text="0.09" LostFocus="TxtSteerReleaseInput_LostFocus" KeyDown="TxtSteerReleaseInput_KeyDown" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,0,0" />
                                                    <TextBlock Grid.Column="1" Text="s" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                </Grid>
                                            </Border>
                                            <Button Content="+ 0.01s" Style="{StaticResource StepBtnStyle}" Click="StepSteerRelease_Click" Tag="0.01" ToolTip="Increase 0.01s" />
                                            <Button Content="+ 0.10s" Style="{StaticResource StepBtnStyle}" Click="StepSteerRelease_Click" Tag="0.10" ToolTip="Increase 0.10s" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <Button Content="Instant Snap (0.01s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerRelease_Click" Tag="0.01" />
                                            <Button Content="Fast (0.05s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerRelease_Click" Tag="0.05" />
                                            <Button Content="Natural (0.09s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerRelease_Click" Tag="0.09" />
                                            <Button Content="Damped (0.18s)" Style="{StaticResource PresetChipBtn}" Click="PresetSteerRelease_Click" Tag="0.18" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Response Curve -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconGraph}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Response Curve" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Curve Type: " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox x:Name="CmbSteerCurveType" SelectionChanged="CmbSteerCurveType_SelectionChanged" Width="180" Height="30" />
                                        </StackPanel>
                                    </Grid>

                                    

                                    <!-- Interactive Bezier Curve Canvas -->
                                    <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Height="180" Margin="0,0,0,10">
                                        <Canvas x:Name="SteerCurveEditorCanvas" Background="Transparent" ClipToBounds="True" SizeChanged="SteerCurveEditorCanvas_SizeChanged" MouseDown="SteerCurveEditorCanvas_MouseDown" MouseMove="SteerCurveEditorCanvas_MouseMove" MouseUp="SteerCurveEditorCanvas_MouseUp" LostMouseCapture="SteerCurveEditorCanvas_LostMouseCapture" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Steering Limit -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Path Data="{StaticResource IconTarget}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Limits" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Min Steering -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Minimum" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtMinSteerDisplay" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="SliderMinSteer" Minimum="0" Maximum="50" Value="0" ValueChanged="SliderMinSteer_ValueChanged" Style="{StaticResource ModernSlider}" Margin="0,0,0,16" />

                                    <!-- Max Steering -->
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Maximum" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtMaxSteerDisplay" Text="100%" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="SliderMaxSteer" Minimum="20" Maximum="100" Value="100" ValueChanged="SliderMaxSteer_ValueChanged" Style="{StaticResource ModernSlider}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= 5. CONTROLLER REMAP PAGE ================= -->
                        <StackPanel x:Name="PageRemap" Visibility="Collapsed">
                            <!-- Page Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Remap" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnResetRemapDefaults" Click="BtnResetRemapDefaults_Click" Content="Reset Defaults" Style="{StaticResource CardActionBtn}" Margin="0,0,8,0" />
                                    <Button x:Name="BtnClearAllRemap" Click="BtnClearAllRemap_Click" Content="Clear All" Style="{StaticResource CardActionBtn}" />
                                </StackPanel>
                            </Grid>

                            <!-- Remap Container (Dynamically rendered category cards) -->
                            <StackPanel x:Name="PnlRemapCategories" />
                        </StackPanel>

                        <!-- ================= 6. AUTO-DETECT / GAMES PAGE ================= -->
                        <StackPanel x:Name="PageGames" Visibility="Collapsed">
                            <!-- Page Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Auto-Detect" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    
                                </StackPanel>
                                <Button x:Name="BtnAddGame" Click="BtnAddGame_Click" Grid.Column="1" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Game" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Master Auto-Activation Switch Card -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconTarget}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Process Monitor" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Border x:Name="BadgeAutoActivationStatus" Background="#20FFFFFF" BorderBrush="{StaticResource StatusActive}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAutoActivationBadge" Text="MONITORING ENABLED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusActive}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Scans active Windows processes and auto-activates Key Trigger when detected" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <Button x:Name="BtnToggleAutoActivation" Click="BtnToggleAutoActivation_Click" Grid.Column="1" Content="Disable Monitor" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Window Focus-Only Mode Switch Card -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="{StaticResource IconGamepad}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Window Focus Detection" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <Border x:Name="BadgeFocusTrackingStatus" Background="#20FFFFFF" BorderBrush="{StaticResource StatusActive}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtFocusTrackingBadge" Text="ACTIVE ONLY WHEN FOCUSED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusActive}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Pause Key Trigger automatically when switching away from the game, and resume when focused" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <Button x:Name="BtnTogglePauseWhenUnfocused" Click="BtnTogglePauseWhenUnfocused_Click" Grid.Column="1" Content="ENABLED" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Dynamic List of Monitored Game Executables -->
                            <StackPanel x:Name="PnlGamesList" />
                        </StackPanel>

                        <!-- ================= 6. PROFILES PAGE ================= -->
                        <StackPanel x:Name="PageProfiles" Visibility="Collapsed">
                            <!-- Page Header -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Profiles" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                                    
                                </StackPanel>
                                <Button x:Name="BtnAddProfile" Click="BtnAddProfile_Click" Grid.Column="1" Style="{StaticResource CardActionBtn}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="New Profile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Active Profile Hotkey Card -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Profile Hotkey" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                        
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnBindProfileHotkey" Click="BtnBindProfileHotkey_Click" Style="{StaticResource CardActionBtn}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Hotkey: " Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock x:Name="TxtProfileHotkeyDisplay" Text="None" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnClearProfileHotkey" Click="BtnClearProfileHotkey_Click" ToolTip="Clear Hotkey" Style="{StaticResource CardActionBtn}" Margin="6,0,0,0" Padding="8,6">
                                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondary}" Width="8" Height="8" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Dynamic List of Profiles -->
                            <StackPanel x:Name="PnlProfileCardsList" />
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
