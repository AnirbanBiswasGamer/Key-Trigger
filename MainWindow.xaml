                                        </StackPanel>
                                        <ProgressBar x:Name="ProgLiveSteerRight" Grid.Row="3" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource BgInput}" Foreground="{StaticResource ChannelSteerRight}" BorderThickness="0" Margin="0,4,12,4" />
                                        <TextBlock x:Name="TxtLiveSteerRightVal" Grid.Row="3" Grid.Column="2" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ChannelSteerRight}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Quick Profile Switcher -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
