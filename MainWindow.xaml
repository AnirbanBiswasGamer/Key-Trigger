                                <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="8" Height="8" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Minimize / Close Buttons with Proper Windows 11 Styling -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource CaptionBtnMinimizeStyle}" Margin="0,0,4,0" ToolTip="Minimize" />
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource CaptionBtnCloseStyle}" ToolTip="Close" />
