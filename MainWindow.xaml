                    <!-- Window Controls (Minimize/Close) & Toast -->
                    <RowDefinition Height="Auto" />
                    <!-- Page Content (ScrollViewer) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Window Controls Bar -->
                <Grid Grid.Row="0" Height="42" Margin="0,0,10,0">
