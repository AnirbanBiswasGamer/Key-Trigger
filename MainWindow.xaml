                                        <ProgressBar x:Name="ProgLiveThrottle" Grid.Row="0" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource BgInput}" Foreground="{StaticResource ChannelThrottle}" BorderThickness="0" Margin="0,4,12,4" />
                                        <TextBlock x:Name="TxtLiveThrottleVal" Grid.Row="0" Grid.Column="2" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ChannelThrottle}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                        <!-- Brake LT -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
