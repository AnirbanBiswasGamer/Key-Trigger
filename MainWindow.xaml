                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnMasterToggle" Click="BtnMasterToggle_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>
                            <Border x:Name="PillMasterToggle" Background="#1A212D" BorderBrush="#2A3547" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotMasterStatus" Grid.Column="0" Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtMasterStatus" Grid.Column="1" Text="DISABLED" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="F8" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>


                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT AREA ================= -->
            <Grid Grid.Column="1">
